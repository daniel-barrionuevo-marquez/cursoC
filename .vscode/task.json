{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compilar para depurar",
            "type": "shell",
            "command": "gcc",
            "args": ["-std=c17", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
                     "-g", "-O0", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
